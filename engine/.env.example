# Copy to .env and fill in values (do not commit .env).

# Server-side OpenAI key (never put this in the macOS app).
OPENAI_API_KEY=sk-...

# Shared secret: macOS app stores this in Keychain and sends Authorization: Bearer <token>.
WISPER_ENGINE_TOKEN=change-me-to-a-long-random-string

# Optional: default is https://api.openai.com/v1
# OPENAI_BASE_URL=https://api.openai.com/v1
